{
  "name": "tomsegbers-de",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env FORCE_COLOR=1 next dev",
    "typecheck": "node_modules/typescript/bin/tsc --noEmit",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "prettier": "prettier --check \"**/*.{js,jsx,ts,tsx}\"",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "contrast": "node scripts/check-contrast.mjs",
    "content:audit": "node scripts/check-content-slop.js",
    "design-tokens": "node scripts/check-design-tokens.mjs",
    "images": "node scripts/check-image-size.mjs",
    "fonts": "node scripts/check-font-budget.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "analyze": "cross-env ANALYZE=true pnpm build",
    "budget:bundle": "node scripts/check-bundle-budget.mjs",
    "lighthouse": "lhci autorun",
    "budget:lighthouse": "lhci autorun",
    "storybook": "cross-env FORCE_COLOR=1 storybook dev -p 6006",
    "test-storybook": "cross-env FORCE_COLOR=1 test-storybook",
    "build-storybook": "cross-env FORCE_COLOR=1 storybook build",
    "test": "cross-env FORCE_COLOR=1 jest --coverage",
    "e2e:headless": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "screenshots:update": "npx tsx scripts/update-readme-screenshots.ts",
    "postinstall": "npx patch-package -y",
    "coupling-graph": "npx madge --extensions js,jsx,ts,tsx,css,md,mdx ./ --exclude '.next|tailwind.config.js|reset.d.ts|prettier.config.js|postcss.config.js|playwright.config.ts|next.config.js|next-env.d.ts|instrumentation.ts|e2e/|README.md|.storybook/|.eslintrc.js' --image graph.svg"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^15.5.28",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-form": "^0.0.3",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "2.0.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@t3-oss/env-nextjs": "^0.7.3",
    "await-to-js": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "gray-matter": "^4.0.3",
    "lodash": "^4.18.1",
    "next": "15.5.28",
    "next-compose-plugins": "^2.2.1",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "resend": "^2.1.0",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
